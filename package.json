{
  "name": "supasync",
  "version": "0.1.0",
  "private": true,
  "description": "Obsidian vault synchronization through Supabase Postgres and object storage",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @supasync/obsidian && npm run build -w @supasync/cli",
    "typecheck": "tsc --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit packages",
    "test:property": "vitest run tests/property",
    "test:integration": "vitest run tests/integration tests/faults",
    "dev:backend": "node scripts/dev-backend.mjs",
    "seed": "node scripts/seed.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "fast-check": "^4.3.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
