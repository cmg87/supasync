{
  "name": "supasync",
  "version": "0.3.0",
  "private": true,
  "description": "Obsidian vault synchronization through Supabase Postgres and object storage",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @supasync/obsidian && npm run build -w supasync && node scripts/package-assets.mjs",
    "typecheck": "tsc --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit packages",
    "test:property": "vitest run tests/property",
    "test:database": "node scripts/test-database.mjs",
    "test:integration": "node scripts/test-database.mjs --http",
    "test:installation": "node scripts/test-installation.mjs",
    "test:package": "node scripts/test-package.mjs",
    "dev:backend": "node apps/cli/dist/cli.js dev start",
    "dev:seed": "node apps/cli/dist/cli.js dev seed",
    "release": "node scripts/release.mjs",
    "dev:plugin": "npm run build -w @supasync/obsidian && node scripts/install-test-vault.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "fake-indexeddb": "6.2.4",
    "fast-check": "^4.3.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "supasync": "^0.3.0"
  }
}
