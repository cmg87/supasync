# Optional Hermes overrides; setup normally saves these in user-only local configuration.
SUPASYNC_DATABASE_URL=postgresql://supasync_hermes:replace-locally@localhost:55432/postgres
SUPASYNC_DATABASE_CA=/absolute/path/to/server-ca.pem
# Binary transfers only. No Supabase login or privileged key is needed by Hermes.
SUPASYNC_URL=https://your-private-backend.example
SUPASYNC_PUBLIC_KEY=replace-with-public-key
