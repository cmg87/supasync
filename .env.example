# Developer stack only. Normal installations generate backend configuration with supasync setup.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-public-key
# Server/admin tests only; never put a privileged key in plugin settings or connection profiles.
SUPABASE_SERVICE_ROLE_KEY=replace-in-local-environment-only
